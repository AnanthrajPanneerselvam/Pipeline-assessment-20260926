  create or replace view `assessment-28596`.`ga4_obfuscated_sample_ecommerce`.`int_user_touchpoints`
  OPTIONS()
  as 

with events as (

    select *
    from `assessment-28596`.`ga4_obfuscated_sample_ecommerce`.`stg_events`

),

session_touchpoints as (
    select
        user_pseudo_id,
        ga_session_id,
        min(event_timestamp) as touchpoint_timestamp,
        min(event_date) as touchpoint_date,
        event_name,
        max(user_acquisition_source) as source,
        max(user_acquisition_medium) as medium
    from events
    where ga_session_id is not null
    group by
        user_pseudo_id, ga_session_id, event_name
)

select distinct
    user_pseudo_id,
    source,
    medium
from session_touchpoints;


